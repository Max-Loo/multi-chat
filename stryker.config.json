{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "inPlace": true,
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vite.config.ts",
    "related": true
  },
  "mutate": [
    "src/services/chat/index.ts",
    "src/services/chat/providerLoader.ts",
    "src/services/chat/metadataCollector.ts",
    "src/services/modelRemote/index.ts",
    "src/services/i18n.ts",
    "src/services/initialization/InitializationManager.ts",
    "src/services/toast/toastQueue.ts",
    "src/stores/chatStore.ts",
    "src/stores/modelProviderStore.ts",
    "src/store/keyring/masterKey.ts",
    "src/utils/crypto.ts",
    "src/utils/resourceLoader.ts",
    "src/utils/highlightLanguageManager.ts",
    "src/utils/tauriCompat/store.ts",
    "src/utils/tauriCompat/keyring.ts",
    "src/utils/tauriCompat/keyringMigration.ts",
    "src/composables/useConfirm.ts",
    "src/composables/useBasicModelTable.ts",
    "src/composables/useResetDataDialog.ts",
    "src/composables/useAdaptiveScrollbar.ts",
    "src/composables/useAutoResizeTextarea.ts",
    "src/composables/useMediaQuery.ts",
    "src/composables/useCreateChat.ts",
    "src/composables/useDebounce.ts",
    "src/composables/useDebouncedFilter.ts",
    "src/composables/useScrollContainer.ts",
    "src/composables/useNavigateToPage.ts",
    "src/composables/useExistingChatList.ts",
    "src/composables/useExistingModels.ts"
  ],
  "reporters": [
    "html",
    "clear-text",
    "progress"
  ],
  "thresholds": {
    "high": 80,
    "low": 60
  },
  "concurrency": 6,
  "timeoutMS": 15000,
  "mutator": {
    "excludedMutations": [
      "StringLiteral"
    ]
  },
  "ignorePatterns": [
    ".agents",
    ".claude",
    ".github",
    ".husky",
    ".kiro",
    ".opencode",
    ".trae",
    ".vscode",
    "src-tauri",
    "dist",
    "coverage",
    "docs",
    "openspec",
    "reports",
    "public"
  ]
}