{
  "name": "multi-chat",
  "version": "0.5.8",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "web:dev": "vite",
    "web:build": "vue-tsc --noEmit && vite build",
    "web:build:tauri": "vue-tsc --noEmit && vite build",
    "tsc": "vue-tsc --noEmit",
    "deploy:gh-pages": "BASE_PATH=/multi-chat/ pnpm web:build && gh-pages -d dist",
    "lint": "oxlint",
    "lint:i18n": "node scripts/check-i18n.js",
    "validate": "npm run lint && npm run lint:i18n",
    "preview": "vite preview",
    "tauri": "tauri",
    "update-version": "node scripts/update-version.js",
    "generate-i18n-types": "node scripts/generate-i18n-types-resources.js",
    "analyze:unused": "knip",
    "prepare": "husky",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest -c vitest.integration.config.ts",
    "test:integration:run": "vitest run -c vitest.integration.config.ts",
    "test:basic:all": "pnpm test:run && pnpm test:integration:run",
    "test:all": "pnpm test:run && pnpm test:integration:run && pnpm test:mutation",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^2.0.24",
    "@ai-sdk/moonshotai": "^2.0.10",
    "@lucide/vue": "^1.38.0",
    "@tanstack/vue-form": "^1.33.5",
    "@tanstack/vue-table": "^9.2.4",
    "@tauri-apps/plugin-http": "~2.5.7",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@tauri-apps/plugin-shell": "~2.3.5",
    "@tauri-apps/plugin-store": "~2.4.2",
    "@vueuse/core": "^14.4.0",
    "ai": "^6.0.116",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "dompurify": "^3.3.2",
    "es-toolkit": "^1.45.1",
    "highlight.js": "^11.11.1",
    "i18next": "^25.8.14",
    "markdown-it": "^14.1.1",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.4",
    "splitpanes": "^4.1.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tauri-plugin-keyring-api": "~0.1.1",
    "virtua": "^0.48.8",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0",
    "vue-sonner": "^2.0.9",
    "zhipu-ai-provider": "^0.2.2"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@types/crypto-js": "^4.2.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.3.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-istanbul": "^4.1.5",
    "@vitest/ui": "^4.0.18",
    "@vue/test-utils": "^2.5.0",
    "autoprefixer": "^10.4.27",
    "fake-indexeddb": "^6.2.5",
    "gh-pages": "^6.3.0",
    "globals": "^17.4.0",
    "happy-dom": "^20.8.3",
    "husky": "^9.1.7",
    "knip": "^5.86.0",
    "lint-staged": "^16.3.2",
    "oxlint": "^1.51.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.3.11",
    "zod": "^4.3.6"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "oxlint --fix"
    ]
  }
}
