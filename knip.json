{
  // Knip 配置文件 - 用于检测项目中未使用的代码
  // 文档: https://knip.dev/
  // 运行命令: pnpm analyze:unused
  "$schema": "https://unpkg.com/knip@5/schema.json",

  // 项目文件匹配模式 - 定义哪些文件应该被分析
  "project": [
    "src/**/*.{ts,vue}",
    "!src/**/*.d.ts"
  ],

  // 忽略的文件和目录 - 这些文件不会被分析
  "ignore": [
    "src/types/**",                 // 类型定义目录
    "src/components/ui-vue/**",     // shadcn-vue 生成物（barrel 完整导出组件库 API 面）
    "src/__test__/helpers/**",      // 测试公共工具面（fixtures/mocks 的 re-export 为有意设计）
  ],

  // 在文件内部使用的导出视为已使用
  "ignoreExportsUsedInFile": true,

  // 忽略的依赖 - 这些依赖不会被标记为未使用
  // 通常包括：类型定义、工具依赖、运行时必需的依赖
  "ignoreDependencies": [
    "@types/*",                   // TypeScript 类型定义
    "autoprefixer",               // CSS 后处理工具
    "globals",                    // JavaScript 全局变量类型
    "lint-staged",                // Git 钩子工具（husky 使用）
  ]
}
